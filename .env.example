# ── 애플리케이션 ────────────────────────────────────────────────
IEUM_ENV=development
IEUM_DEBUG=true
# 32바이트 이상 무작위 문자열. 생성: `make secret`
# 이 키에서 세션·MFA 시크릿 암호화 키를 파생하므로 분실 시 복구 불가.
IEUM_SECRET_KEY=change-me-to-a-random-32-byte-string
IEUM_BASE_URL=http://localhost:5173

# ── 데이터베이스 ────────────────────────────────────────────────
IEUM_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ieum
# pytest 전용. 비우면 testcontainers 로 일회용 Postgres 를 띄운다.
IEUM_TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ieum_test

# ── Redis ──────────────────────────────────────────────────────
IEUM_REDIS_URL=redis://localhost:6379/0

# ── 오브젝트 스토리지 (MinIO / S3) ──────────────────────────────
IEUM_S3_ENDPOINT_URL=http://localhost:9000
IEUM_S3_REGION=us-east-1
IEUM_S3_BUCKET=ieum-attachments
IEUM_S3_ACCESS_KEY=minioadmin
IEUM_S3_SECRET_KEY=minioadmin

# ── 메일 ────────────────────────────────────────────────────────
IEUM_SMTP_HOST=localhost
IEUM_SMTP_PORT=1025
IEUM_SMTP_TLS=false
IEUM_MAIL_FROM=ieum@example.com

# ── 인증 정책 ───────────────────────────────────────────────────
IEUM_ACCESS_TOKEN_TTL_SECONDS=900        # 15분
IEUM_REFRESH_TOKEN_TTL_SECONDS=1209600   # 14일
IEUM_STEP_UP_WINDOW_SECONDS=300          # 5분
IEUM_PASSWORD_MIN_LENGTH=12

# ── 시드 ────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please-12
